#!/sbin/sh
# Magisk / KernelSU dual-compatible install stub
umask 022
OUTFD=$2
ZIPFILE=$3

ui_print() {
  if [ -n "$OUTFD" ]; then
    echo "ui_print $1" > "$OUTFD"
    echo "ui_print" > "$OUTFD"
  fi
}

abort() {
  ui_print "$1"
  exit 1
}

mount /data 2>/dev/null

if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
  install_module
  exit 0
fi

if [ -f /data/adb/ksu/bin/util_functions.sh ]; then
  . /data/adb/ksu/bin/util_functions.sh
  install_module
  exit 0
fi

abort "! 未检测到 Magisk 或 KernelSU, 无法安装"
